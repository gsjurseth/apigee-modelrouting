def main():
    parser = argparse.ArgumentParser(
        description="Compile declarative Model Routing config files (modelrouting/*.yaml) to Apigee Feature Templates (AFT)."
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # translate
    p_trans = subparsers.add_parser("translate", help="Translate a modelrouting/*.yaml file to an AFT template YAML")
    p_trans.add_argument("config", help="Path to Model Routing YAML file (e.g. modelrouting/05-failover-gateway.yaml)")
    p_trans.add_argument("--proxy-name", help="Override target Apigee proxy name")
    p_trans.add_argument("--base-path", help="Override BASE_PATH parameter")

    # diff (side-by-side view)
    p_diff = subparsers.add_parser("diff", help="Show Model Routing config and compiled AFT template side-by-side")
    p_diff.add_argument("config", help="Path to Model Routing YAML file (e.g. modelrouting/05-failover-gateway.yaml)")

    # import (translate + gcloud beta apigee apis import)
    p_imp = subparsers.add_parser("import", help="Translate Model Routing config to AFT and import into Apigee via gcloud")
    p_imp.add_argument("config", help="Path to Model Routing YAML file (e.g. modelrouting/01-single-model.yaml)")
    p_imp.add_argument("--organization", "-o", default=os.environ.get("APIGEE_ORG", "apigee-product-demo"))
    p_imp.add_argument("--proxy-name", help="Override target Apigee proxy name")
    p_imp.add_argument("--base-path", help="Override BASE_PATH parameter")

    # add-model (onboard a brand-spanking-new model live in 1 command)
    p_add = subparsers.add_parser(
        "add-model",
        help="Onboard a brand-new model into a modelrouting config and auto-synthesize its AFT feature",
    )
    p_add.add_argument("config", help="Source modelrouting/*.yaml file")
    p_add.add_argument("--name", required=True, help="Client-facing model_name (e.g. grok-3)")
    p_add.add_argument("--model", required=True, help="Provider/model identifier (e.g. xai/grok-3-beta)")
    p_add.add_argument("--api-base", help="Optional target endpoint URL")
    p_add.add_argument("--rpm", type=int, default=300, help="Requests Per Minute quota (default: 300)")
    p_add.add_argument("--tpm", type=int, default=600000, help="Tokens Per Minute quota (default: 600000)")
    p_add.add_argument("--out", help="Optional output YAML path (defaults to updating config in-place)")

    # sync-kvm (bridge os.environ/<KEY> references to Apigee Encrypted KVM)
    p_kvm = subparsers.add_parser(
        "sync-kvm",
        help="Generate/execute Apigee Encrypted KVM provisioning for `os.environ/<KEY>` provider credentials",
    )
    p_kvm.add_argument("config", help="Source modelrouting/*.yaml file")
    p_kvm.add_argument("--organization", "-o", default=os.environ.get("APIGEE_ORG", "apigee-product-demo"))
    p_kvm.add_argument("--environment", "-e", default=os.environ.get("APIGEE_ENV", "dev-prog-proxy"))
    p_kvm.add_argument("--kvm-name", help="Override Apigee Encrypted KVM map name")

    # sync-datacollectors (register dc_llm_* DataCollectors for token breakdown dashboards)
    p_dc = subparsers.add_parser(
        "sync-datacollectors",
        help="Generate/register Apigee DataCollector resources (dc_llm_*) for token breakdown dashboards",
    )
    p_dc.add_argument("--organization", "-o", default=os.environ.get("APIGEE_ORG", "apigee-product-demo"))

    args = parser.parse_args()
    root_dir = Path(__file__).resolve().parent
    demo_dir = root_dir / "demo"

    if args.command == "add-model":
        handle_add_model(args, demo_dir)
        return
    if args.command == "sync-kvm":
        handle_sync_kvm(args)
        return
    if args.command == "sync-datacollectors":
        handle_sync_datacollectors(args)
        return

    config_path = Path(args.config)
    if not config_path.exists():
        sys.exit(f"Error: Model Routing config file not found: {config_path}")

    aft_yaml_str, report, out_path = compile_modelrouting_to_aft(
        config_path,
        demo_dir,
        proxy_name_override=getattr(args, "proxy_name", None),
        base_path_override=getattr(args, "base_path", None),
    )

    with open(out_path, "w", encoding="utf-8") as f:
        f.write(aft_yaml_str)

    if args.command == "translate":
        print_translation_report(report, aft_yaml_str)
    elif args.command == "diff":
        print_side_by_side(config_path, aft_yaml_str, report)
    elif args.command == "import":
        print_translation_report(report, aft_yaml_str)
        token_file = Path("/tmp/adc_token.txt")
        try:
            tok = subprocess.check_output(
                ["gcloud", "auth", "application-default", "print-access-token"],
                stderr=subprocess.DEVNULL,
                text=True,
            ).strip()
            if tok:
                token_file.write_text(tok + "\n", encoding="utf-8")
        except Exception:
            pass
        cmd = [
            "gcloud",
            "beta",
            "apigee",
            "apis",
            "import",
            report["proxy_name"],
            f"--from-template={out_path}",
            f"--organization={args.organization}",
        ]
        if token_file.exists():
            cmd.append(f"--access-token-file={token_file}")
        print(
            f"\n▶ {BOLD}Executing:{RESET} gcloud beta apigee apis import {report['proxy_name']} "
            f"--from-template=demo/{out_path.name} --organization={args.organization}"
        )
        res = subprocess.run(cmd)
        sys.exit(res.returncode)


if __name__ == "__main__":
    main()
