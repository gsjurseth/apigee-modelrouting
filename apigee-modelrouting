def print_side_by_side(config_path: Path, aft_yaml_str: str, report: dict):
    with open(config_path, "r", encoding="utf-8") as f:
        left_lines = [
            line.rstrip()
            for line in f.read().splitlines()
            if not line.strip().startswith("#")
        ]
    while left_lines and not left_lines[0].strip():
        left_lines.pop(0)

    right_lines = aft_yaml_str.rstrip().splitlines()
    col_width = 46
    max_rows = max(len(left_lines), len(right_lines))

    print(f"{BOLD}{CYAN}==================================================================================================={RESET}")
    print(
        f" {BOLD}{YELLOW}{'Model Routing Config (What You Write)':<{col_width}}{RESET} │ "
        f"{BOLD}{GREEN}{'Compiled Apigee AFT Template (Generated)'}{RESET}"
    )
    print(f" {DIM}{str(config_path):<{col_width}}{RESET} │ {DIM}{report['output_file']}{RESET}")
    print(f"{BOLD}{CYAN}--------------------------------────────────────┼──────────────────────────────────────────────────{RESET}")
    for i in range(max_rows):
        l_txt = left_lines[i] if i < len(left_lines) else ""
        r_txt = right_lines[i] if i < len(right_lines) else ""
        if len(l_txt) > col_width:
            l_txt = l_txt[: col_width - 1] + "…"
        print(f" {YELLOW}{l_txt:<{col_width}}{RESET} │ {GREEN}{r_txt}{RESET}")
    print(f"{BOLD}{CYAN}==================================================================================================={RESET}")


def handle_add_model(args, demo_dir: Path):
    """Add a brand-new model (or new model version) to a modelrouting YAML file and synthesize its AFT feature."""
    src_path = Path(args.config)
    if not src_path.exists():
        sys.exit(f"Error: Model Routing config file not found: {src_path}")

    with open(src_path, "r", encoding="utf-8") as f:
        cfg = yaml.safe_load(f) or {}

    model_list = cfg.setdefault("model_list", [])
    provider = args.model.split("/", 1)[0] if "/" in args.model else "custom"
    api_base = args.api_base or f"https://api.{provider}.com/v1/chat/completions"

    new_entry = {
        "model_name": args.name,
        "model_params": {
            "model": args.model,
            "api_base": api_base,
            "api_key": f"os.environ/{provider.upper()}_API_KEY",
            "rpm": args.rpm,
            "tpm": args.tpm,
        },
    }
    model_list = [e for e in model_list if e.get("model_name") != args.name]
    model_list.append(new_entry)
    cfg["model_list"] = model_list

    dest_path = Path(args.out) if args.out else src_path
    with open(dest_path, "w", encoding="utf-8") as f:
        yaml.dump(cfg, f, sort_keys=False, default_flow_style=False)

    feat_name = model_string_to_feature_filename(args.model)
    print(
        f"{BOLD}{MAGENTA}★ Added model '{args.name}' ({args.model} -> demo/{feat_name}) to {dest_path}{RESET}\n"
    )
    aft_yaml_str, report, out_path = compile_modelrouting_to_aft(dest_path, demo_dir)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write(aft_yaml_str)
    print_translation_report(report, aft_yaml_str)


def handle_sync_kvm(args):
    """Inspect all `os.environ/<KEY>` references in a Model Routing config and generate/sync the Apigee Encrypted KVM."""
    src_path = Path(args.config)
    if not src_path.exists():
        sys.exit(f"Error: Model Routing config file not found: {src_path}")

    with open(src_path, "r", encoding="utf-8") as f:
        cfg = yaml.safe_load(f) or {}

    gateway_settings = cfg.get("gateway_settings") or {}
    auth_cfg = gateway_settings.get("auth") or {}
    kvm_name = args.kvm_name or (auth_cfg.get("kvm_name") if isinstance(auth_cfg, dict) else None) or "llm-provider-credentials"

    keys = []
    for entry in cfg.get("model_list") or []:
        params = entry.get("model_params") or {}
        api_key = str(params.get("api_key") or "")
        model_str = str(params.get("model") or "")
        if api_key.startswith("os.environ/"):
            k = api_key.split("/", 1)[1]
            keys.append((entry.get("model_name"), model_str, k, "KVM Encrypted Entry"))
        elif model_str.startswith(("vertex_ai/", "gemini/", "google/")):
            keys.append((entry.get("model_name"), model_str, "(None - GCP IAM Service Account)", "GoogleAccessToken"))

    print(f"{BOLD}{CYAN}============================================================================={RESET}")
    print(f"{BOLD} Apigee Encrypted KVM & Southbound Auth Provisioning Plan{RESET}")
    print(f"{BOLD}{CYAN}============================================================================={RESET}")
    print(f"  {BOLD}Organization / Env:{RESET}  {args.organization} / {args.environment}")
    print(f"  {BOLD}Encrypted KVM Map:{RESET}   {GREEN}{kvm_name}{RESET}  (encrypted: true)")
    print(f"{DIM}-----------------------------------------------------------------------------{RESET}")
    for m_name, m_str, k_name, mode in keys:
        env_present = "✔ set in local env" if os.environ.get(k_name) else "○ read at deploy time"
        badge = f"[{env_present}]" if mode == "KVM Encrypted Entry" else "[Zero-Key IAM]"
        print(f"  • {YELLOW}{m_name:<18}{RESET} ({m_str:<36}) -> {GREEN}{k_name:<20}{RESET} {DIM}{badge}{RESET}")
    print(f"{DIM}-----------------------------------------------------------------------------{RESET}")
    print(f"  {BOLD}Apigee Management API Commands to Provision Encrypted KVM:{RESET}\n")
    print(
        f'    TOKEN="$(gcloud auth application-default print-access-token)"\n'
        f'    curl -X POST "https://apigee.googleapis.com/v1/organizations/{args.organization}/environments/{args.environment}/keyvaluemaps" \\\n'
        f'      -H "Authorization: Bearer ${{TOKEN}}" -H "Content-Type: application/json" \\\n'
        f'      -d \'{{"name": "{kvm_name}", "encrypted": true}}\''
    )
    for _, _, k_name, mode in keys:
        if mode == "KVM Encrypted Entry":
            print(
                f'\n    curl -X POST "https://apigee.googleapis.com/v1/organizations/{args.organization}/environments/{args.environment}/keyvaluemaps/{kvm_name}/entries" \\\n'
                f'      -H "Authorization: Bearer ${{TOKEN}}" -H "Content-Type: application/json" \\\n'
                f'      -d \'{{"name": "{k_name}", "value": "\'"${{{k_name}:-YOUR_KEY}}"\'"}}\''
            )
    print(f"{BOLD}{CYAN}============================================================================={RESET}")


