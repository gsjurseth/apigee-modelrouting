def model_string_to_feature_filename(model_str: str) -> str:
    """
    Deterministic 1:1 Heuristic mapping a `<provider>/<model-version>` string
    directly to a self-evident, version-specific AFT feature filename:
      - openai/gpt-4o                        -> target-openai-gpt-4o.yaml
      - vertex_ai/gemini-2.5-flash           -> target-vertex-ai-gemini-2.5-flash.yaml
      - vertex_ai/gemini-3.5-flash           -> target-vertex-ai-gemini-3.5-flash.yaml
      - anthropic/claude-3-5-sonnet-20241022 -> target-anthropic-claude-3-5-sonnet-20241022.yaml
      - bedrock/llama-3.3-70b-instruct       -> target-bedrock-llama-3.3-70b-instruct.yaml
      - cohere/command-r-plus-08-2024        -> target-cohere-command-r-plus-08-2024.yaml
      - mistral/mistral-large-2411           -> target-mistral-large-2411.yaml
      - deepseek/deepseek-reasoner           -> target-deepseek-reasoner.yaml
    """
    if "/" in model_str:
        provider, model_id = model_str.lower().split("/", 1)
    else:
        provider, model_id = "openai", model_str.lower()
    p_slug = re.sub(r"[^a-z0-9.]+", "-", provider).strip("-")
    m_slug = re.sub(r"[^a-z0-9.]+", "-", model_id).strip("-")
    if m_slug.startswith(f"{p_slug}-"):
        return f"target-{m_slug}.yaml"
    return f"target-{p_slug}-{m_slug}.yaml"


def synthesize_model_target_feature(
    demo_dir: Path,
    feature_filename: str,
    model_name: str,
    provider: str,
    model_id: str,
    params: dict,
) -> str:
    """
    Heuristic Feature Synthesizer: when a user adds a brand-new provider or a new model
    version (e.g. `deepseek/deepseek-reasoner`, `vertex_ai/gemini-3.5-flash`,
    `anthropic/claude-3-7-sonnet-20250219`) to `model_list` that doesn't yet have
    a `demo/target-<provider>-<model-version>.yaml` file on disk, automatically
    generate a self-contained AFT feature (`type: feature`) pinned to that exact
    model version (`model_id`).
    """
    feature_stem = feature_filename[:-5] if feature_filename.endswith(".yaml") else feature_filename
    slug = re.sub(r"[^a-z0-9]+", "-", feature_stem.replace("target-", "")).strip("-")
    pascal = "".join(part.capitalize() for part in slug.split("-"))
    feature_path = demo_dir / feature_filename
    target_name = f"{slug}-target"

    is_vertex = provider in ("vertex_ai", "gemini", "google")
    if is_vertex:
        project = params.get("vertex_project") or os.environ.get("APIGEE_ORG", "apigee-product-demo")
        location = params.get("vertex_location") or "us-central1"
        default_url = (
            f"https://{location}-aiplatform.googleapis.com/v1beta1/projects/{project}"
            f"/locations/{location}/endpoints/openapi/chat/completions"
        )
    elif provider == "anthropic":
        default_url = "https://api.anthropic.com/v1/messages"
    elif provider == "cohere":
        default_url = "https://api.cohere.com/v1/chat"
    elif provider == "bedrock":
        region = params.get("aws_region_name") or "us-east-1"
        default_url = f"https://bedrock-runtime.{region}.amazonaws.com/model/{model_id}/converse"
    else:
        default_url = f"https://api.{provider}.com/v1/chat/completions"

    api_base = params.get("api_base") or default_url
    js_policy_name = f"JS-Normalize{pascal}Request"
    am_policy_name = f"AM-Set{pascal}Headers"
    js_resource_name = f"normalize-{slug}-request.js"

    target_entry = {
        "name": target_name,
        "url": api_base,
    }
    if is_vertex:
        # Automatically configure GoogleAccessToken Service Account authentication for Vertex AI targets
        target_entry["auth"] = "GoogleAccessToken"
        target_entry["scopes"] = ["https://www.googleapis.com/auth/cloud-platform"]

    target_entry["flows"] = [
        {
            "name": "PreFlow",
            "mode": "Request",
            "steps": [{"name": js_policy_name}],
        },
        {
            "name": "PostFlow",
            "mode": "Response",
            "steps": [{"name": am_policy_name}],
        },
    ]

    feature_doc = {
        "gateway": "apigee",
        "schemaVersion": "1.0.0",
        "name": feature_stem,
        "type": "feature",
        "description": (
            f"Auto-synthesized AFT model feature for '{model_name}' "
            f"({provider}/{model_id}). Self-registers route rule, TargetEndpoint ({api_base}), "
            f"and model version normalization pinned to '{model_id}'."
        ),
        "defaultEndpoint": {
            "name": "default",
            "routes": [
                {
                    "name": f"route-{slug}",
                    "condition": (
                        f'llm.model = "{model_name}" or '
                        f'llm.model = "{model_id}" or '
                        f'llm.model = "{provider}/{model_id}" or '
                        f'llm.model StartsWith "{model_name}"'
                    ),
                    "target": target_name,
                }
            ],
        },
        "targets": [target_entry],
        "policies": [
            {
                "name": js_policy_name,
                "type": "Javascript",
                "content": {
                    "Javascript": {
                        "metadata": {
                            "name": js_policy_name,
                            "timeLimit": "200",
                            "continueOnError": "false",
                            "enabled": "true",
                        },
                        "DisplayName": js_policy_name,
                        "ResourceURL": {"_text": f"jsc://{js_resource_name}"},
                    }
                },
            },
            {
                "name": am_policy_name,
                "type": "AssignMessage",
                "content": {
                    "AssignMessage": {
                        "metadata": {
                            "name": am_policy_name,
                            "continueOnError": "true",
                            "enabled": "true",
                        },
                        "DisplayName": am_policy_name,
                        "Set": {
                            "Headers": {
                                "Header": [
                                    {"metadata": {"name": "x-apigee-model"}, "_text": model_id},
                                    {"metadata": {"name": "x-apigee-provider"}, "_text": provider},
                                ]
                            }
                        },
                        "IgnoreUnresolvedVariables": "true",
                        "AssignTo": {
                            "metadata": {
                                "createNew": "false",
                                "transport": "http",
                                "type": "response",
                            }
                        },
                    }
                },
            },
        ],
        "resources": [
            {
                "name": js_resource_name,
                "type": "jsc",
                "content": (
                    "try {\n"
                    '  var raw = context.getVariable("request.content");\n'
                    "  if (raw) {\n"
                    "    var body = JSON.parse(raw);\n"
                    f'    body.model = "{model_id}";\n'
                    '    context.setVariable("request.content", JSON.stringify(body));\n'
                    "  }\n"
                    "} catch (e) {\n"
                    f'  print("Error normalizing {slug} request: " + e);\n'
                    "}\n"
                ),
            }
        ],
    }

    with open(feature_path, "w", encoding="utf-8") as f:
        yaml.dump(feature_doc, f, sort_keys=False, default_flow_style=False)
    return feature_filename


def is_auto_synthesized_feature(feature_path: Path) -> bool:
    """Return True if the feature file on disk was created by the heuristic synthesizer."""
    if not feature_path.exists():
        return False
    try:
        text = feature_path.read_text(encoding="utf-8")
        return "Auto-synthesized AFT model feature" in text
    except Exception:
        return False


def compile_modelrouting_to_aft(
    config_path: Path,
    demo_dir: Path,
    proxy_name_override: str = None,
    base_path_override: str = None,
):
    """Parse a declarative Model Routing config.yaml and return (aft_yaml_str, report_metadata, out_path)."""
    with open(config_path, "r", encoding="utf-8") as f:
        cfg = yaml.safe_load(f) or {}

    fname = config_path.name
    defaults = STAGE_DEFAULTS.get(fname, {})
    general = cfg.get("general_settings") or {}
    router_settings = cfg.get("router_settings") or {}
    gateway_settings = cfg.get("gateway_settings") or {}

    proxy_name = (
        proxy_name_override
        or general.get("proxy_name")
        or defaults.get("proxy_name")
        or f"aft-modelrouting-{re.sub(r'[^a-z0-9]+', '-', config_path.stem.lower()).strip('-')}"
    )
    base_path = (
        base_path_override
        or general.get("base_path")
        or defaults.get("base_path")
        or f"/v1/chat/{re.sub(r'[^a-z0-9]+', '-', config_path.stem.lower()).strip('-')}"
    )
    description = general.get("description") or defaults.get(
        "description",
        f"Apigee AI Gateway Proxy compiled from Model Routing config ({fname}).",
    )

    include_cors = (
        defaults.get("include_cors", False)
        or bool(general.get("enable_cors"))
        or bool(gateway_settings.get("drop_params"))
    )

    model_list = cfg.get("model_list") or []
    mapped_models = []
    auto_router_cfg = None
    referenced_env_keys = []

    for entry in model_list:
        m_name = entry.get("model_name", "default")
        params = entry.get("model_params") or entry.get("params") or {}
        full_model = params.get("model", "")

        if "/" in full_model:
            provider, model_id = full_model.split("/", 1)
        else:
            provider, model_id = "openai", full_model

        provider_low = provider.lower()

        # Check for Auto Router / Complexity Router pseudo-model
        if provider_low == "auto_router" or (m_name == "auto" and "complexity_router" in full_model):
            auto_router_cfg = entry.get("complexity_router_config") or {
                "classifier_model": "vertex_ai/gemini-2.5-flash-lite",
                "tiers": {
                    "SIMPLE_QA": ["gemini-2.5-flash"],
                    "CODING": ["claude-3-5-sonnet"],
                    "COMPLEX_REASONING": ["gpt-4o"],
                },
            }
            continue

        api_key_ref = str(params.get("api_key") or "")
        if api_key_ref.startswith("os.environ/"):
            k_name = api_key_ref.split("/", 1)[1]
            if k_name not in referenced_env_keys:
                referenced_env_keys.append(k_name)
        elif api_key_ref.startswith("kvm/"):
            k_name = api_key_ref.split("/")[-1]
            if k_name not in referenced_env_keys:
                referenced_env_keys.append(k_name)

        # Deterministic 1:1 Heuristic: `<provider>/<model-version>` -> `target-<provider>-<model-version>.yaml`
        feat_file = model_string_to_feature_filename(full_model)
        feat_path = demo_dir / feat_file

        if not feat_path.exists():
            synthesize_model_target_feature(demo_dir, feat_file, m_name, provider_low, model_id, params)
            is_synthesized = True
        else:
            is_synthesized = is_auto_synthesized_feature(feat_path)

        if is_synthesized:
            transcoding = f"★ AUTO-SYNTHESIZED ({provider_low}/{model_id}) -> demo/{feat_file}"
        else:
            proto_desc = PROVIDER_PROTOCOL_INFO.get(
                provider_low, f"OpenAI-compatible ({provider_low})"
            )
            transcoding = f"Pinned to '{model_id}' ({proto_desc})"

        rpm = params.get("rpm")
        tpm = params.get("tpm")
        mapped_models.append({
            "model_name": m_name,
            "target_model": full_model,
            "provider": provider_low,
            "model_id": model_id,
            "feature": feat_file,
            "transcoding": transcoding,
            "rpm": rpm,
            "tpm": tpm,
            "api_key_ref": api_key_ref,
            "is_synthesized": is_synthesized,
        })

    if auto_router_cfg is not None or router_settings.get("routing_strategy") == "semantic-routing":
        include_cors = True

    fallbacks = (
        router_settings.get("fallbacks")
        or gateway_settings.get("fallbacks")
        or cfg.get("fallbacks")
        or []
    )
    context_window_fallbacks = router_settings.get("context_window_fallbacks") or []
    content_policy_fallbacks = router_settings.get("content_policy_fallbacks") or []
    routing_strategy = router_settings.get("routing_strategy")
    num_retries = router_settings.get("num_retries")
    retry_after = router_settings.get("retry_after")
    timeout = router_settings.get("timeout")
    cooldown_time = router_settings.get("cooldown_time")

    has_router_policy = bool(
        routing_strategy
        or num_retries is not None
        or context_window_fallbacks
        or content_policy_fallbacks
        or cooldown_time is not None
    )

    sem_cache_cfg = gateway_settings.get("semantic_cache") or {}
    has_semantic_cache = bool(
        sem_cache_cfg is True
        or (isinstance(sem_cache_cfg, dict) and sem_cache_cfg.get("enabled", bool(sem_cache_cfg)))
    )

    model_armor_cfg = gateway_settings.get("model_armor") or {}
    has_model_armor = bool(
        model_armor_cfg is True
        or (isinstance(model_armor_cfg, dict) and model_armor_cfg.get("enabled", bool(model_armor_cfg)))
    )

    # Enterprise Auth Settings (`gateway_settings.auth`)
    auth_cfg = gateway_settings.get("auth") or {}
    has_kvm_auth = bool(
        isinstance(auth_cfg, dict)
        and (
            auth_cfg.get("provider_keys") == "kvm"
            or auth_cfg.get("kvm_enabled") is True
            or auth_cfg.get("kvm_name")
        )
    )
    has_client_auth = bool(
        general.get("master_key")
        or (isinstance(auth_cfg, dict) and auth_cfg.get("client_auth") in ("api_key", "verify_api_key", True))
    )

    # Automatic DataCollector Token Analytics (`gateway_settings.token_analytics`)
    token_analytics_cfg = gateway_settings.get("token_analytics") or {}
    has_token_analytics = bool(
        token_analytics_cfg is True
        or (isinstance(token_analytics_cfg, dict) and token_analytics_cfg.get("enabled", bool(token_analytics_cfg)))
    )

    if (
        fallbacks
        or has_router_policy
        or has_semantic_cache
        or has_model_armor
        or has_kvm_auth
        or has_token_analytics
    ):
        include_cors = True

    # Assemble ordered feature list matching our AFT templates
    features = ["llm-base.yaml"]
    if include_cors:
        features.append("llm-cors.yaml")
    if has_client_auth:
        features.append("llm-client-auth.yaml")
    features.append("llm-openai-format.yaml")

    if has_kvm_auth:
        features.append("llm-auth-kvm.yaml")

    if has_model_armor:
        features.append("llm-model-armor.yaml")

    if has_semantic_cache:
        features.append("llm-semantic-cache.yaml")

    if has_router_policy:
        features.append("llm-retry-and-loadbalance.yaml")

    if auto_router_cfg is not None or routing_strategy == "semantic-routing":
        features.append("llm-semantic-router.yaml")

    for m in mapped_models:
        if m["feature"] not in features:
            features.append(m["feature"])

    if fallbacks:
        features.append("llm-failover.yaml")

    if has_token_analytics:
        features.append("llm-token-analytics.yaml")

    # Build parameters list
    parameters = [{"name": "BASE_PATH", "default": base_path}]
    if has_kvm_auth and isinstance(auth_cfg, dict) and auth_cfg.get("kvm_name"):
        parameters.append({"name": "KVM_MAP_NAME", "default": str(auth_cfg["kvm_name"])})
    if has_model_armor and isinstance(model_armor_cfg, dict) and model_armor_cfg.get("template_id"):
        parameters.append({"name": "MA_TEMPLATE_PATH", "default": str(model_armor_cfg["template_id"])})
    if has_semantic_cache and isinstance(sem_cache_cfg, dict):
        if sem_cache_cfg.get("similarity_threshold") is not None:
            parameters.append(
                {"name": "THRESHOLD", "default": f"{float(sem_cache_cfg['similarity_threshold']):.2f}"}
            )
        if sem_cache_cfg.get("ttl_seconds") is not None:
            parameters.append({"name": "TTL_SECONDS", "default": str(sem_cache_cfg["ttl_seconds"])})

    # Build AFT YAML string with clean formatting
    lines = [
        "gateway: apigee",
        "schemaVersion: 1.0.0",
        f"name: {proxy_name}",
        "description: >",
    ]
    words = description.split()
    cur_line = "  "
    for w in words:
        if len(cur_line) + len(w) + 1 > 76:
            lines.append(cur_line)
            cur_line = "  " + w
        else:
            cur_line = (cur_line + " " + w) if cur_line.strip() else ("  " + w)
    if cur_line.strip():
        lines.append(cur_line)

    lines.append("features:")
    for feat in features:
        lines.append(f"  - {feat}")

    lines.append("parameters:")
    for p in parameters:
        lines.append(f"  - name: {p['name']}")
        val = p["default"]
        if re.match(r"^[0-9.]+$", str(val)):
            lines.append(f'    default: "{val}"')
        else:
            lines.append(f"    default: {val}")
    lines.append("")
    aft_yaml_str = "\n".join(lines)

    out_path = demo_dir / fname
    report = {
        "input_file": str(config_path),
        "output_file": str(out_path),
        "proxy_name": proxy_name,
        "base_path": base_path,
        "include_cors": include_cors,
        "mapped_models": mapped_models,
        "referenced_env_keys": referenced_env_keys,
        "routing_strategy": routing_strategy,
        "num_retries": num_retries,
        "retry_after": retry_after,
        "timeout": timeout,
        "cooldown_time": cooldown_time,
        "fallbacks": fallbacks,
        "context_window_fallbacks": context_window_fallbacks,
        "content_policy_fallbacks": content_policy_fallbacks,
        "has_router_policy": has_router_policy,
        "has_semantic_cache": has_semantic_cache,
        "sem_cache_cfg": sem_cache_cfg if isinstance(sem_cache_cfg, dict) else {},
        "has_model_armor": has_model_armor,
        "model_armor_cfg": model_armor_cfg if isinstance(model_armor_cfg, dict) else {},
        "has_kvm_auth": has_kvm_auth,
        "has_client_auth": has_client_auth,
        "auth_cfg": auth_cfg if isinstance(auth_cfg, dict) else {},
        "has_token_analytics": has_token_analytics,
        "token_analytics_cfg": token_analytics_cfg if isinstance(token_analytics_cfg, dict) else {},
        "auto_router": auto_router_cfg,
        "features": features,
    }
    return aft_yaml_str, report, out_path


def format_fallback_chain(fallbacks: list) -> str:
    parts = []
    for item in fallbacks:
        if isinstance(item, dict):
            for src, targets in item.items():
                ranked = " -> ".join(f"[P{idx+1}] {t}" for idx, t in enumerate(targets))
                parts.append(f"{src} ==> {ranked}")
    return "; ".join(parts)


def print_translation_report(report: dict, aft_yaml_str: str):
